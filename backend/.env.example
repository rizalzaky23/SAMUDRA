# ==============================================
# SAMUDRA — Aplikasi Deteksi Tsunami
# Environment Variables
# Copy file ini ke .env dan isi nilainya
# ==============================================

# App
NODE_ENV=development
PORT=3000

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=samudra_db
DB_USER=samudra_user
DB_PASSWORD=samudra_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
# Daftar di: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# URL frontend yang akan menerima token setelah login Google berhasil (untuk Web)
# Flutter tidak perlu ini, karena callback akan mengembalikan JSON langsung
GOOGLE_AUTH_SUCCESS_REDIRECT=http://localhost:3001/auth/callback

# AWS S3 (untuk media artikel blog)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=samudra-media

# Firebase Cloud Messaging (untuk push notification)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# BMKG API (tidak butuh auth, ini hanya catatan URL dasar)
BMKG_API_BASE_URL=https://data.bmkg.go.id/DataMKG/TEWS
BMKG_POLLING_INTERVAL_MS=60000

# Google Maps (untuk Flutter)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
